#!/usr/bin/env bash
# cspawn — spawn a new headless-claude session in a target directory.
#
# Usage:
#   cspawn [dir]            # spawn claude session in dir (defaults to $PWD)
#   cspawn -a [dir]         # spawn and print the tmux attach command
#   cspawn --json [dir]     # raw JSON response
set -euo pipefail

ENV_FILE="${HEADLESS_CLAUDE_ENV:-/home/talhabera/claude-projects/headless-claude/.env}"

# shellcheck disable=SC1090
[ -f "$ENV_FILE" ] || { echo "cspawn: env file not found: $ENV_FILE" >&2; exit 1; }
set -a; . "$ENV_FILE"; set +a

HOST="${HOST:-127.0.0.1}"
PORT="${PORT:-3000}"
TOKEN="${AUTH_TOKEN:?AUTH_TOKEN not set in $ENV_FILE}"

attach=0
json=0
dir=""
for arg in "$@"; do
  case "$arg" in
    -a|--attach) attach=1 ;;
    --json) json=1 ;;
    -h|--help) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) dir="$arg" ;;
  esac
done

dir="${dir:-$PWD}"
[ -d "$dir" ] || { echo "cspawn: not a directory: $dir" >&2; exit 1; }
dir="$(cd "$dir" && pwd)"

resp="$(curl -fsS -X POST "http://${HOST}:${PORT}/spawn" \
  -H "Authorization: Bearer ${TOKEN}" \
  -H 'Content-Type: application/json' \
  -d "$(printf '{"cwd":"%s"}' "$dir")")"

if [ "$json" = 1 ]; then
  echo "$resp"
  exit 0
fi

# parse with python (jq isn't guaranteed present)
read -r name cwd < <(python3 -c "
import json, sys
d = json.loads(sys.stdin.read())
if not d.get('ok'):
    sys.stderr.write('cspawn: spawn failed: ' + d.get('reason','unknown') + '\n')
    sys.exit(2)
print(d['name'], d['cwd'])
" <<<"$resp")

echo "spawned $name in $cwd"
[ "$attach" = 1 ] && echo "attach: tmux attach -t $name"
exit 0
