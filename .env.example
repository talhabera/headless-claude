PORT=3000
HOST=127.0.0.1
# Target tmux session count. Watchdog keeps this many `claude` tmux sessions alive.
POOL_TARGET=2
# Hard cap (manual /spawn or future scaling won't exceed this).
POOL_MAX=10
# Watchdog interval — every N ms, top up missing sessions.
WATCHDOG_MS=15000
# Required if HOST is not loopback. If unset on loopback, a token is generated on startup.
AUTH_TOKEN=
POOL_CWD=/home/talhabera/claude-projects
